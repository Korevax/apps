# Copy to .env.local. Never commit real credentials.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173

# Public gateway origin consumed by Vite (optional in local development).
# Production builds require an HTTPS gateway URL to enable external search.
VITE_CATALOG_GATEWAY_URL=http://127.0.0.1:8787

# TMDB API Read Access Token (Bearer token), server-side only.
TMDB_API_READ_ACCESS_TOKEN=
